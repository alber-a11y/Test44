{
  "name": "hearthguard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "assets:fetch": "bash tools/fetch-assets.sh",
    "assets:models": "node tools/build-models.mjs",
    "assets:audio": "python3 tools/audio/build_audio.py",
    "balance": "esbuild tools/sim/balance.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/balance.mjs --log-level=warning && node node_modules/.cache/balance.mjs",
    "test": "esbuild tools/sim/smoke.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/smoke.mjs --log-level=warning && node node_modules/.cache/smoke.mjs"
  },
  "dependencies": {
    "@fontsource/rubik": "^5.3.0",
    "@fontsource/russo-one": "^5.3.0",
    "@preact/signals": "^2.11.3",
    "n8ao": "^2.0.1",
    "postprocessing": "^6.39.5",
    "preact": "^10.29.8",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/three": "^0.186.0",
    "meshoptimizer": "^1.3.0",
    "playwright": "^1.64.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.4"
  }
}
